# Build output
*/build/
build/
.gradle/

# Local machine configuration — never committed, generated by Android Studio/Gradle per machine
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.kotlin/

# Keystores — a real signing key must never reach this public repository
*.jks
*.keystore

# macOS
.DS_Store

# Note: no `google-services.json` entry. `adr/0180` moved push from FCM to RuStore Push, and the
# RuStore SDK takes a project-ID string rather than a credentials file, so there is nothing of
# that shape for a later item to leak here (`26-07`'s own Scope).
