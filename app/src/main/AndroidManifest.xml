<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        `26-12`: the app talks to `Ago.Chat.Api` and to the Keycloak realm, both over HTTPS. No
        cleartext permission, no `usesCleartextTraffic` — API 28+ blocks cleartext by default and
        nothing here needs it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AgoChatApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:theme="@style/Theme.AgoChat"
        android:supportsRtl="true">

        <!--
            `android:allowBackup="false"` above is load-bearing for `26-12`, not only tidiness:
            the session store holds a refresh token, and Android's own backup transport would
            otherwise copy that file off the device. `android:dataExtractionRules` is the other
            half of the same guarantee on Android 12+, where device-to-device transfer is a
            separate channel `allowBackup` does not reach — see `res/xml/data_extraction_rules.xml`.

            No launcher icon set yet: the real one arrives with the mockups this item is
            deliberately not drawing from (`26-07`'s own Out of scope — "no screen from the
            inventory"). Android falls back to the system default without one.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AgoChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            `25-213`: the intent-filter and its `android:scheme` are still spelled exactly once, in
            AppAuth's own library manifest via the `appAuthRedirectScheme` placeholder in
            `app/build.gradle.kts` — this declaration adds no data or intent-filter of its own, so
            that stays true. What it adds is the one attribute the library's own declaration leaves
            unset: a theme. `net.openid.appauth.AuthorizationManagementActivity` (the other AppAuth
            activity, launched first) ships its own `Theme.AppCompat.Translucent.NoTitleBar` in the
            library manifest and never crashed; `RedirectUriReceiverActivity` — launched second, when
            the browser redirects back — declares no theme at all, so it inherited this
            application's own `Theme.AgoChat`, which descends `android:Theme.Material.Light`, not
            `Theme.AppCompat`. `AppCompatActivity.onCreate` (both AppAuth activities extend it)
            requires the latter unconditionally — confirmed live, on a real phone: every sign-in
            crashed on the redirect back from Keycloak with `IllegalStateException: You need to use
            a Theme.AppCompat theme (or descendant) with this activity`, the exact wording thrown at
            `AppCompatDelegateImpl.createSubDecor`.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar" />
    </application>

</manifest>
