<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        `26-12`: the app talks to `Ago.Chat.Api` and to the Keycloak realm, both over HTTPS. No
        cleartext permission, no `usesCleartextTraffic` — API 28+ blocks cleartext by default and
        nothing here needs it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        `26-85`: `OperatorPresenceService`'s own four permissions - all normal (install-time, never a
        runtime prompt), so none of these adds a dialog anywhere in the app.

        - `FOREGROUND_SERVICE`: the base permission every foreground service has needed since API 28;
          this app's `targetSdk` (34) is well past that floor.
        - `FOREGROUND_SERVICE_CONNECTED_DEVICE`: the per-type permission Android 14 (API 34) requires
          declared for each `android:foregroundServiceType` a service actually uses - this service
          declares exactly `connectedDevice` below, so this is the one matching permission, not a set.
        - `CHANGE_NETWORK_STATE`: the platform's own runtime check for the `connectedDevice` type
          additionally requires the app to hold at least one of a fixed list of connectivity-flavoured
          permissions (Bluetooth, NFC, USB, or this one) - confirmed against Android's own foreground-
          service-types documentation, not exercised on a real API 34 device in this sandbox (no
          emulator here; flagged `[~]` in this item's own report). This app has no Bluetooth/NFC/USB use
          case at all, so this normal, always-granted permission is declared solely to satisfy that
          check for a service whose actual job - a persistent SignalR connection - is a network one.
        - `REQUEST_IGNORE_BATTERY_OPTIMIZATIONS`: required to launch
          `Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS` at all (`MainActivity`'s own launcher).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        `26-06`: `POST_NOTIFICATIONS` (API 33+) ships in `pushclient-7.5.0.aar`'s own manifest and
        merges in automatically — RuStore's own documentation states this has been the SDK's default
        since 1.4.0. Declared here as a comment, not a line, so a future reader searching this file for
        the permission finds the explanation rather than concluding it is missing. The *runtime*
        request (`ActivityResultContracts.RequestPermission`) is `26-18`'s job, alongside rendering the
        first real notification — asking for it before this app can show anything would be a permission
        prompt an operator has no way to connect to a benefit yet.
    -->

    <application
        android:name=".AgoChatApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AgoChat"
        android:supportsRtl="true">

        <!--
            `android:allowBackup="false"` above is load-bearing for `26-12`, not only tidiness:
            the session store holds a refresh token, and Android's own backup transport would
            otherwise copy that file off the device. `android:dataExtractionRules` is the other
            half of the same guarantee on Android 12+, where device-to-device transfer is a
            separate channel `allowBackup` does not reach — see `res/xml/data_extraction_rules.xml`.

            `26-34`: the launcher icon this comment used to say was still missing. The real
            adaptive icon (`res/mipmap-anydpi-v26/ic_launcher.xml` and `ic_launcher_round.xml`,
            wiring `drawable/ic_launcher_background.xml`, `ic_launcher_foreground.xml` and
            `ic_launcher_monochrome.xml`) is drawn from the brandbook mark, not from the mockups
            `26-07` deliberately left out of scope - the brandbook's gradient tile and its glyph
            are a separate source from the screen inventory.
        -->
        <!--
            `26-18`: `android:launchMode="singleTop"` - a notification tap while the app is already
            running builds an explicit `Intent` naming this `Activity` directly
            (`PushNotificationPresenter.openConversationPendingIntent`), with
            `FLAG_ACTIVITY_CLEAR_TOP or FLAG_ACTIVITY_SINGLE_TOP` set on it. Without this manifest
            attribute those flags would still bring the existing task to the front, but a *new*
            `MainActivity` instance would be pushed onto it (`standard`, this app's launch-mode
            default until now, always creates a fresh instance), stacking a second `NavController` and
            a second copy of every screen's own state rather than delivering to the one that is already
            there through `onNewIntent` - see that override's own doc comment for the back-stack
            consequence this exists to avoid.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AgoChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            `25-213`: the intent-filter and its `android:scheme` are still spelled exactly once, in
            AppAuth's own library manifest via the `appAuthRedirectScheme` placeholder in
            `app/build.gradle.kts` — this declaration adds no data or intent-filter of its own, so
            that stays true. What it adds is the one attribute the library's own declaration leaves
            unset: a theme. `net.openid.appauth.AuthorizationManagementActivity` (the other AppAuth
            activity, launched first) ships its own `Theme.AppCompat.Translucent.NoTitleBar` in the
            library manifest and never crashed; `RedirectUriReceiverActivity` — launched second, when
            the browser redirects back — declares no theme at all, so it inherited this
            application's own `Theme.AgoChat`, which descends `android:Theme.Material.Light`, not
            `Theme.AppCompat`. `AppCompatActivity.onCreate` (both AppAuth activities extend it)
            requires the latter unconditionally — confirmed live, on a real phone: every sign-in
            crashed on the redirect back from Keycloak with `IllegalStateException: You need to use
            a Theme.AppCompat theme (or descendant) with this activity`, the exact wording thrown at
            `AppCompatDelegateImpl.createSubDecor`.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar" />

        <!--
            `26-06`/`adr/0180`: RuStore's own required shape - a service extending
            `RuStoreMessagingService`, `exported="true"` with an intent-filter on exactly this action
            string, both copied verbatim from RuStore's own Kotlin/Java Push SDK documentation rather
            than guessed at. `exported="true"` is the SDK's own distributor-delivery mechanism (the
            distributor app, running in its own process, is what starts this service) and not a gap
            this app introduced - `tools:ignore` says so for Lint's `ExportedService` check the same
            way RuStore's own sample manifest does.
        -->
        <service
            android:name="ago.chat.android.devices.AgoPushMessagingService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="ru.rustore.sdk.pushclient.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            `26-85`: never started by anything outside this app (`exported="false"`) - only
            `ForegroundServiceLauncher`'s own `startService`/`stopService` calls, which already run in
            this process, ever name this class. `foregroundServiceType="connectedDevice"` is mandatory
            from API 34 for a service that calls `startForeground` at all - "maintains a connection to a
            remote system" (this service's actual job, an operator's own SignalR hub connection) is the
            documented use case that type exists for; omitting it is a hard manifest-merger/runtime
            failure on API 34+, not a style choice (`docs/backlog/26-85-*.md`).
        -->
        <service
            android:name="ago.chat.android.presence.OperatorPresenceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
