<?xml version="1.0" encoding="utf-8"?>
<!--
    `26-34`: identical content to `ic_launcher.xml` - the round/non-round distinction is the
    *launcher's* masking choice, applied on top of the same background+foreground+monochrome
    layers, not something this app's resources need to express differently.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
