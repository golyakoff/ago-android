    <!--
        `26-30`: the mockup's own short form - «4 ч» / «20 мин» / «2 д», no «Открыт»/«Ждёт» prefix of
        any kind. Plain formatted strings, not `<plurals>`: unlike the full words these replaced
        («час»/«часа»/«часов»), a short unit abbreviation does not inflect by count in Russian - «1 мин»
        and «20 мин» use the identical word, so there is no plural rule left to express.
    -->
    <string name="conversation_list_elapsed_minutes_short">%d мин</string>
    <string name="conversation_list_elapsed_hours_short">%d ч</string>
    <string name="conversation_list_elapsed_days_short">%d д</string>

    <!--
        `26-64`: the row's *spoken* form of the same elapsed time — full, correctly declined Russian
        words rather than `conversation_list_elapsed_*_short`'s deliberately un-inflected abbreviation
        ("4 ч" says nothing useful to a TTS engine; "4 часа" does). Three forms per unit because Russian's
        own plural rule has three buckets (one/few/many) where English has two — selected in code
        (`russianPluralStringResource`, `ElapsedText.kt`) rather than via `<plurals>`, for the same reason
        `conversation_list_elapsed_*_short`'s own comment gives for skipping `<plurals>` one step further:
        `<plurals>` picks its bucket from the *device's* locale, and this app ships one locale
        (`26-10`) with no `setApplicationLocales` override, so a device set to English would pick English's
        two-bucket rule and hand back the wrong Russian ending for "2" or "5".
    -->
    <string name="conversation_row_elapsed_minutes_one">%1$d минута</string>
    <string name="conversation_row_elapsed_minutes_few">%1$d минуты</string>
    <string name="conversation_row_elapsed_minutes_many">%1$d минут</string>
    <string name="conversation_row_elapsed_hours_one">%1$d час</string>
